<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WorkGuard</AssemblyName>
    <Version>0.9.0-preview.2</Version>
    <Product>工作防沉迷</Product>
    <Description>让休息自然发生的 Windows 桌面工具</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/*.png" />
    <ProjectReference Include="../WorkGuard.Core/WorkGuard.Core.csproj" />
    <ProjectReference Include="../WorkGuard.Data/WorkGuard.Data.csproj" />
  </ItemGroup>
</Project>
