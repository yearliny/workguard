<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WorkGuard.Windows.Views" x:Class="WorkGuard.Windows.Views.ReminderWindow" Style="{StaticResource AppWindow}" Title="工作防沉迷 · 轻提醒" Width="480" Height="320" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" KeyDown="Window_KeyDown" Background="#203F37" Foreground="#FAFAF4">
 <Border BorderBrush="#476458" BorderThickness="1" Padding="24"><StackPanel ui:Motion.Enter="True">
  <StackPanel Orientation="Horizontal"><ui:Symbol Text="&#xE916;" FontSize="16" Foreground="#BDD3C3" Margin="0,0,9,0"/><TextBlock Text="工作防沉迷 / 给自己一个空隙" Foreground="#BDD3C3" FontSize="12"/></StackPanel>
  <Grid Margin="0,18,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Description" Foreground="#D0DDD3" LineHeight="24" FontSize="14" Margin="0,10,0,0"/></StackPanel><Border Grid.Column="1" CornerRadius="16"><Border.Background><ImageBrush ImageSource="{StaticResource SanctuaryArt}" Stretch="UniformToFill"/></Border.Background></Border></Grid>
  <WrapPanel><Button x:Name="StartButton" Content="开始活动" Background="#E6EFE2" Foreground="#203B34" ui:Visuals.Glyph="&#xE768;" Click="Start_Click"/><Button x:Name="DismissButton" Content="5 分钟后" Background="Transparent" Foreground="#E6EFE2" BorderBrush="#648172" ui:Visuals.Glyph="&#xE823;" Click="Dismiss_Click"/></WrapPanel>
  <TextBlock x:Name="Footnote" Text="手头的事，稍后可以接着做。" FontSize="12" Foreground="#BDD3C3" Margin="0,10,0,0"/>
 </StackPanel></Border>
</Window>
