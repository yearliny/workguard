<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WorkGuard.Windows.Views" x:Class="WorkGuard.Windows.Views.ReminderWindow" Style="{StaticResource AppWindow}" Title="工作防沉迷 · 轻提醒" Width="460" Height="310" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" KeyDown="Window_KeyDown">
 <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="24" Background="{StaticResource CardBrush}"><StackPanel>
  <StackPanel Orientation="Horizontal"><ui:Symbol Text="&#xE916;" FontSize="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0"/><TextBlock Text="工作防沉迷 · 休息一下" Foreground="{StaticResource MutedBrush}" FontSize="13"/></StackPanel>
  <DockPanel Margin="0,16,0,12"><Image DockPanel.Dock="Right" Source="{StaticResource WindowArt}" Width="86" Height="90" Margin="12,0,0,0" Stretch="Uniform" IsHitTestVisible="False"/><StackPanel><TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="Description" Foreground="{StaticResource MutedBrush}" LineHeight="24" Margin="0,10,0,0"/></StackPanel></DockPanel>
  <WrapPanel><Button x:Name="StartButton" Content="开始活动" Style="{StaticResource PrimaryButton}" ui:Visuals.Glyph="&#xE768;" Click="Start_Click"/><Button Content="5 分钟后" ui:Visuals.Glyph="&#xE823;" Click="Dismiss_Click"/></WrapPanel>
  <TextBlock Text="不便打断？此提醒会自动收起。" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
 </StackPanel></Border>
</Window>