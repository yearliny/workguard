<Window x:Class="WorkGuard.Windows.Views.ReminderWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource AppWindow}" Title="工作防沉迷 · 轻提醒" Width="430" Height="290" WindowStyle="None" ResizeMode="NoResize"
 ShowInTaskbar="False" ShowActivated="False" Topmost="True" KeyDown="Window_KeyDown">
 <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24" Background="{DynamicResource CardBrush}">
  <StackPanel>
   <DockPanel><TextBlock Text="工作防沉迷" Foreground="{DynamicResource MutedBrush}"/><TextBlock DockPanel.Dock="Right" Text="轻提醒" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel>
   <TextBlock x:Name="Heading" FontSize="25" FontWeight="SemiBold" Margin="0,18,0,8"/>
   <TextBlock x:Name="Description" Foreground="{DynamicResource MutedBrush}" LineHeight="23" Margin="0,0,0,15"/>
   <WrapPanel><Button x:Name="StartButton" Content="开始活动" Style="{StaticResource PrimaryButton}" Click="Start_Click"/><Button Content="5 分钟后" Click="Dismiss_Click"/></WrapPanel>
   <TextBlock Text="不便打断？此提醒会自动收起。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
  </StackPanel>
 </Border>
</Window>
