<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WorkGuard.Windows.Views" x:Class="WorkGuard.Windows.Views.SettingsWindow" Style="{StaticResource AppWindow}" Title="工作防沉迷 · 设置" Width="800" Height="800" MinWidth="700" MinHeight="580" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Padding" Value="10,12"/></Style>
    <Style x:Key="DayChoice" TargetType="CheckBox">
      <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinWidth" Value="54"/><Setter Property="MinHeight" Value="44"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="DayBorder" CornerRadius="14" Background="White" BorderBrush="#CBD8CF" BorderThickness="1" Padding="10">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="DayBorder" Property="Background" Value="#326958"/><Setter Property="Foreground" Value="White"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DayBorder" Property="BorderBrush" Value="#B37239"/><Setter TargetName="DayBorder" Property="BorderThickness" Value="3"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <DockPanel Margin="28" ui:Motion.Enter="True">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18"><Image DockPanel.Dock="Right" Source="{StaticResource WindowArt}" Width="88" Height="80" Margin="16,0,0,0" Stretch="Uniform" IsHitTestVisible="False"/><StackPanel VerticalAlignment="Center">
      <TextBlock Text="为自己，留一点余地" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="温和提醒，或到点全屏。选择适合你的约束力度。" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
    </StackPanel></DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <TextBlock x:Name="ValidationText" Foreground="#9B382E" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="取消" ui:Visuals.Glyph="&#xE711;" Click="Cancel_Click"/>
        <Button x:Name="SaveButton" Content="保存设置" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" ui:Visuals.Glyph="&#xE74E;" Click="Save_Click"/>
      </DockPanel>
    </StackPanel>
    <TabControl x:Name="Sections" Background="Transparent" BorderThickness="0">
      <TabItem Header="休息节奏" ui:Visuals.Glyph="&#xE916;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,20,20,0" ui:Motion.Enter="True">
            <TextBlock Text="选一个起点，之后随时调整" FontSize="18" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,10,0,16">
              <Button Content="日常 · 20 / 50" Tag="50" ui:Visuals.Glyph="&#xE916;" Click="Preset_Click"/>
              <Button Content="专注 · 20 / 60" Tag="60" ui:Visuals.Glyph="&#xE916;" Click="Preset_Click"/>
            </WrapPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="眼睛休息间隔 · 10–60 分钟" VerticalAlignment="Center"/>
              <TextBox x:Name="EyeInterval" Grid.Column="1" AutomationProperties.Name="眼睛休息间隔，分钟" Margin="0,4"/>
              <TextBlock Text="身体活动间隔 · 30–120 分钟" Grid.Row="1" VerticalAlignment="Center"/>
              <TextBox x:Name="MovementInterval" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="身体活动间隔，分钟" Margin="0,4"/>
              <TextBlock Text="自然休息阈值 · 3–15 分钟" Grid.Row="2" VerticalAlignment="Center"/>
              <TextBox x:Name="NaturalRest" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="自然休息阈值，分钟" Margin="0,4"/>
            </Grid>
            <CheckBox x:Name="EyeEnabled" Content="开启 20 秒眼睛休息提醒"/>
            <CheckBox x:Name="InferRest" Content="长时间没有键鼠输入时，推测已自然休息"/>
            <TextBlock Text="空闲不一定表示离席。经常阅读或看视频时，可以关闭自然休息推测。" Foreground="{StaticResource MutedBrush}"/>
            <Separator Margin="0,20"/>
            <TextBlock Text="活动方式" FontSize="18" FontWeight="SemiBold"/>
            <CheckBox x:Name="Gentle" Content="仅轻柔活动"/>
            <TextBlock Text="开启后不包含坐站、墙壁俯卧撑与提踵。所有方案都不跳跃、不做地面动作。出现疼痛、麻木或头晕时，请停止活动。" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="强制休息" ui:Visuals.Glyph="&#xE916;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,20,20,0" ui:Motion.Enter="True">
            <TextBlock Text="到点了，就先休息" FontSize="22" FontWeight="SemiBold"/>
            <CheckBox x:Name="Strict" Content="开启强制休息模式"/>
            <TextBlock Text="身体活动到点直接全屏开始 3 分钟，覆盖连接的显示器。不能普通跳过、暂停或推迟；完成后自动回到工作。" Foreground="{StaticResource MutedBrush}"/>
            <CheckBox x:Name="ForceEyes" Content="眼睛休息也强制全屏 · 20 秒"/>
            <TextBlock Text="关闭这一项，眼睛休息仍使用轻提醒。眼睛提醒总开关位于「休息节奏」。" Foreground="{StaticResource MutedBrush}"/>
            <Button x:Name="PreviewStrict" Content="体验 20 秒强制全屏" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="PreviewStrict_Click"/>
            <TextBlock Text="立即体验；不会保存或更改上述设置。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
            <Separator Margin="0,18"/>
            <CheckBox x:Name="Neck" Content="身体活动中加入温和转头"/>
            <TextBlock Text="默认关闭。仅在转头舒适、没有活动限制时开启；有颈部疾病、受伤或恢复期请遵循专业建议。不绕颈、不压头、不追求幅度。" Foreground="{StaticResource MutedBrush}"/>
            <Border Style="{StaticResource Card}" Margin="0,18">
              <StackPanel>
                <TextBlock Text="约束工作，不勉强身体" FontWeight="SemiBold"/>
                <TextBlock Text="动作不适合时可改为安静休息，倒计时不缩短，也不记为完整身体活动。Esc 或右上角可打开紧急退出确认；退出后 5 分钟再提醒。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                <TextBlock Text="会议模式、安静时段和全屏静默设置仍然有效。系统快捷键与 Windows 锁屏始终可用。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="减少打扰" ui:Visuals.Glyph="&#xE708;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,20,20,0" ui:Motion.Enter="True">
            <TextBlock Text="保留专注的空间" FontSize="20" FontWeight="SemiBold"/>
            <CheckBox x:Name="QuietFullscreen" Content="其他应用全屏时，静默计时"/>
            <TextBlock Text="视频会议可在托盘中开启「会议模式」。会议期间继续计时，暂停休息提醒。" Foreground="{StaticResource MutedBrush}"/>
            <CheckBox x:Name="Sound" Content="活动切换与结束时播放轻提示音"/>
            <CheckBox x:Name="ReducedMotion" Content="减少动态效果"/>
            <TextBlock Text="关闭页面进入、按钮与进度过渡动画。也会遵循 Windows 的动画效果设置。" Foreground="{StaticResource MutedBrush}"/>
            <Separator Margin="0,20"/>
            <CheckBox x:Name="QuietEnabled" Content="每天的安静时段"/>
            <TextBlock Text="只计时，不弹出提醒。支持跨午夜，例如 22:00 到 07:00。" Foreground="{StaticResource MutedBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,16">
              <TextBox x:Name="QuietStart" Width="100" AutomationProperties.Name="安静时段开始，24 小时制"/>
              <TextBlock Text="至" VerticalAlignment="Center" Margin="16,0"/>
              <TextBox x:Name="QuietEnd" Width="100" AutomationProperties.Name="安静时段结束，24 小时制"/>
            </StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="提前安排不被打扰的时间" FontWeight="SemiBold"/>
                <TextBlock Text="普通提醒不会抢走键盘焦点，40 秒后自动收起；稍后 5 分钟再提醒。普通活动支持暂停、跳过和 Esc 退出。强制模式使用单独的紧急退出确认。" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="通用与数据" ui:Visuals.Glyph="&#xE713;">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,20,20,0" ui:Motion.Enter="True">
            <CheckBox x:Name="Startup" Content="登录 Windows 时启动"/>
            <TextBlock Text="请先把解压后的程序放在固定目录，再开启自启动。" Foreground="{StaticResource MutedBrush}"/>
            <Separator Margin="0,20"/>
            <TextBlock Text="你的数据，由你保管" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="无账户、无广告、无遥测。只读取最后一次输入的时间，不记录按键内容或屏幕。设置与最近 90 天的统计保存在本机。" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,14"/>
            <WrapPanel>
              <Button Content="导出统计 CSV" ui:Visuals.Glyph="&#xE74E;" Click="Export_Click"/>
              <Button Content="打开数据文件夹" ui:Visuals.Glyph="&#xE8B7;" Click="Data_Click"/>
            </WrapPanel>
            <Button x:Name="BackupButton" Content="恢复上次保存的备份" HorizontalAlignment="Left" ui:Visuals.Glyph="&#xE72C;" Click="Restore_Click"/>
            <TextBlock Text="写入失败会保留原文件并提示；恢复前会再次确认。诊断日志仅保存在本地，不自动上传。" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,24"/>
            <TextBlock x:Name="VersionText" FontWeight="SemiBold"/>
            <TextBlock Text="这是一款工作日休息工具，不提供诊断或个体化康复治疗。已有疾病、受伤或手术恢复期，请遵循专业人员的活动建议。" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="ScheduleTab" Header="工作安排" ui:Visuals.Glyph="&#xE787;">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,20,20,0" ui:Motion.Enter="True">
            <TextBlock Text="专注有时，休息有约" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="让提醒融入你的工作日。时间均使用电脑本地时间。" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,14"/>
            <CheckBox x:Name="WorkEnabled" Content="只在指定的工作时段自动提醒"/>
            <StackPanel IsEnabled="{Binding IsChecked, ElementName=WorkEnabled}">
              <WrapPanel Margin="0,10,0,16">
                <CheckBox x:Name="Monday" Content="一" Style="{StaticResource DayChoice}" AutomationProperties.Name="周一"/>
                <CheckBox x:Name="Tuesday" Content="二" Style="{StaticResource DayChoice}" AutomationProperties.Name="周二"/>
                <CheckBox x:Name="Wednesday" Content="三" Style="{StaticResource DayChoice}" AutomationProperties.Name="周三"/>
                <CheckBox x:Name="Thursday" Content="四" Style="{StaticResource DayChoice}" AutomationProperties.Name="周四"/>
                <CheckBox x:Name="Friday" Content="五" Style="{StaticResource DayChoice}" AutomationProperties.Name="周五"/>
                <CheckBox x:Name="Saturday" Content="六" Style="{StaticResource DayChoice}" AutomationProperties.Name="周六"/>
                <CheckBox x:Name="Sunday" Content="日" Style="{StaticResource DayChoice}" AutomationProperties.Name="周日"/>
              </WrapPanel>
              <StackPanel Orientation="Horizontal">
                <TextBox x:Name="WorkStart" Width="100" AutomationProperties.Name="工作时段开始，24 小时制"/>
                <TextBlock Text="至" VerticalAlignment="Center" Margin="16,0"/>
                <TextBox x:Name="WorkEnd" Width="100" AutomationProperties.Name="工作时段结束，24 小时制"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Text="支持跨午夜，例如周五 22:00 至次日 07:00。时段外不自动提醒，仍按原规则估计用屏；手动休息随时可用。" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
            <Separator Margin="0,20"/>
            <CheckBox x:Name="OfficeEnabled" Content="预约每天一次的 7 分钟活动"/>
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=OfficeEnabled}">
              <TextBox x:Name="OfficeTime" Width="100" AutomationProperties.Name="7 分钟活动预约，24 小时制"/>
              <TextBlock Text="给自己留一个小约定" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="16,0,0,0"/>
            </StackPanel>
            <TextBlock Text="到时轻声邀请，由你点击开始；即使开启强制模式，也不会自动开始 7 分钟活动。当天已经完成过该活动则不再邀请。" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,18,0,12">
              <StackPanel>
                <TextBlock Text="错过了，就留到下一天" FontWeight="SemiBold"/>
                <TextBlock Text="预约后的 30 分钟内，遇到会议、全屏、离席或安静时段会等待；超过窗口就略过。每天最多邀请一次，重启不会重复。预约也遵循工作时段；未开启工作安排时则每天有效。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
