<Window x:Class="WorkGuard.Windows.Views.DashboardWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="工作防沉迷 · 今日" Width="920" Height="760" MinWidth="620" MinHeight="500" WindowStartupLocation="CenterScreen">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="40,30">
   <DockPanel Margin="0,0,0,30">
    <Button DockPanel.Dock="Right" Content="设置" Click="Settings_Click"/>
    <StackPanel><TextBlock Text="工作防沉迷" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="给专注留一点空隙。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
   </DockPanel>
   <Border Background="#E5ECE3" CornerRadius="22" Padding="32">
    <StackPanel>
     <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}"/>
     <WrapPanel VerticalAlignment="Bottom" Margin="0,12,0,0"><TextBlock x:Name="ContinuousText" FontSize="64" FontWeight="Light"/><TextBlock Text="分钟 / 本轮连续工作估计" VerticalAlignment="Bottom" Margin="14,0,0,15"/></WrapPanel>
     <TextBlock x:Name="NextText" Margin="0,0,0,18"/>
     <WrapPanel><Button Content="现在活动 3 分钟" Style="{StaticResource PrimaryButton}" Click="Movement_Click"/><Button x:Name="PauseButton" Content="暂停提醒 1 小时" Click="Pause_Click"/></WrapPanel>
    </StackPanel>
   </Border>
   <TextBlock Text="今天，照顾了几次自己" FontSize="20" FontWeight="SemiBold" Margin="0,30,0,16"/>
   <UniformGrid Columns="3">
    <StackPanel><TextBlock Text="电脑活动估计" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ActiveText" FontSize="28" Margin="0,8"/></StackPanel>
    <StackPanel><TextBlock Text="最长连续工作" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LongestText" FontSize="28" Margin="0,8"/></StackPanel>
    <StackPanel><TextBlock Text="完成身体活动" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="BreaksText" FontSize="28" Margin="0,8"/></StackPanel>
   </UniformGrid>
   <TextBlock x:Name="EyeText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20"/>
   <WrapPanel><Button Content="眼睛休息 20 秒" Click="Eyes_Click"/><Button Content="办公室活动 7 分钟" Click="Office_Click"/></WrapPanel>
   <TextBlock Text="最近 7 天" FontSize="20" FontWeight="SemiBold" Margin="0,26,0,10"/>
   <TextBlock Text="按本地日期记录。完成次数表示计时流程完成，不代表软件验证了身体动作。" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
   <DataGrid x:Name="WeekGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" RowHeight="38" ColumnHeaderHeight="36" MinHeight="80">
    <DataGrid.Columns>
     <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="*"/>
     <DataGridTextColumn Header="电脑活动" Binding="{Binding Active}" Width="*"/>
     <DataGridTextColumn Header="最长连续" Binding="{Binding Longest}" Width="*"/>
     <DataGridTextColumn Header="身体 / 眼睛" Binding="{Binding Breaks}" Width="*"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="关闭这个窗口后，提醒仍在系统托盘运行。无账户，无广告，所有记录只保存在这台电脑。" Foreground="{StaticResource MutedBrush}" Margin="0,24,0,0"/>
  </StackPanel>
 </ScrollViewer>
</Window>
