<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WorkGuard.Windows.Views" x:Class="WorkGuard.Windows.Views.BreakWindow" Style="{StaticResource AppWindow}" Title="工作防沉迷 · 休息" Width="780" Height="740" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="#EDF1E8" KeyDown="Window_KeyDown">
  <Border BorderThickness="1" BorderBrush="#D7E0D3" Padding="28">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
        <Button x:Name="ExitButton" DockPanel.Dock="Right" Content="退出 · Esc" ui:Visuals.Glyph="&#xE711;" Click="Exit_Click" Padding="12,8" Background="Transparent"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ui:Symbol Text="&#xE916;" FontSize="20" Margin="0,0,12,0"/><StackPanel><TextBlock Text="工作防沉迷" FontWeight="SemiBold"/><TextBlock Text="给身体的片刻留白" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
      </DockPanel>
      <Border x:Name="EmergencyPanel" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FFF6E8" CornerRadius="18" Padding="16" Margin="0,0,0,12" MaxWidth="800">
        <StackPanel>
          <TextBlock Text="需要立刻使用电脑？" FontWeight="SemiBold" FontSize="18"/>
          <TextBlock Text="退出后不会记为完成，5 分钟后再提醒。身体不适请立即停止活动。" Margin="0,6"/>
          <WrapPanel><Button x:Name="ConfirmExitButton" Content="确认紧急退出" Click="ConfirmExit_Click"/><Button x:Name="ContinueButton" Content="继续休息" Click="Continue_Click"/></WrapPanel>
        </StackPanel>
      </Border>
      <TextBlock x:Name="Footnote" DockPanel.Dock="Bottom" Text="以舒适为准。疼痛、麻木或头晕时，请停止。" TextAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
      <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,10,0,0">
        <Button x:Name="StartButton" Content="开始休息" Style="{StaticResource PrimaryButton}" ui:Visuals.Glyph="&#xE768;" Click="Start_Click"/>
        <Button x:Name="PauseButton" Content="暂停" ui:Visuals.Glyph="&#xE769;" Click="Pause_Click" Visibility="Collapsed"/>
        <Button x:Name="SkipButton" Content="跳过这个动作" ui:Visuals.Glyph="&#xE893;" Click="Skip_Click" Visibility="Collapsed"/>
        <Button x:Name="AlternativeButton" Content="动作不适合 · 改为安静休息" Click="Alternative_Click" Visibility="Collapsed" Background="Transparent"/>
        <Button x:Name="SnoozeButton" Content="5 分钟后提醒" ui:Visuals.Glyph="&#xE823;" Click="Exit_Click"/>
      </WrapPanel>
      <Border x:Name="JourneyPanel" DockPanel.Dock="Bottom" MaxWidth="1360" Background="#CCFFFFFF" CornerRadius="20" Padding="24,16" Margin="12,16,12,0">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <TextBlock x:Name="TotalCountdown" DockPanel.Dock="Right" FontSize="22" FontWeight="SemiBold" Margin="16,0,0,0"/>
            <TextBlock x:Name="JourneyLabel" FontSize="14" VerticalAlignment="Center"/>
          </DockPanel>
          <ProgressBar x:Name="TotalProgress" Minimum="0" Maximum="100" Height="8" Foreground="{StaticResource AccentBrush}" Background="#DFE5DD" BorderThickness="0" AutomationProperties.Name="整场休息流程进度"/>
          <Grid x:Name="JourneyMarkers" Margin="0,7,0,0"/>
          <TextBlock x:Name="JourneyNote" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <Grid x:Name="SceneLayout" MaxWidth="1440" Margin="8,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SceneryColumn" Width="0.85*"/></Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="SceneContent" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,12" ui:Motion.Enter="True">
            <Border CornerRadius="20" Background="#DDE7DA" Padding="14,7" HorizontalAlignment="Center" Margin="0,0,0,14"><TextBlock x:Name="Eyebrow" Text="先放下手头的事" TextAlignment="Center" FontSize="12" Foreground="{StaticResource AccentBrush}"/></Border>
            <Border x:Name="StateBadge" Style="{StaticResource IconBadge}" Width="52" Height="52" CornerRadius="16" HorizontalAlignment="Center" Margin="0,6" Visibility="Collapsed"><ui:Symbol x:Name="CompletionSymbol" Text="&#xE8FB;" FontSize="26" Foreground="{StaticResource AccentBrush}"/></Border>
            <TextBlock x:Name="Heading" Text="身体需要活动一下" FontSize="38" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock x:Name="Instruction" FontSize="16" TextAlignment="Center" LineHeight="26" Margin="0,0,0,16"/>
            <Grid x:Name="TimerFace" Width="204" Height="204" Margin="0,4,0,14">
              <ui:ProgressRing x:Name="SessionRing" Stroke="{StaticResource AccentBrush}"/>
              <StackPanel VerticalAlignment="Center"><TextBlock x:Name="Countdown" FontSize="48" FontWeight="Light" TextAlignment="Center"/><TextBlock x:Name="TimerCaption" Text="留给自己的时间" Foreground="{StaticResource MutedBrush}" FontSize="12" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel>
            </Grid>
            <ProgressBar x:Name="Progress" Height="3" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="#DCE5D7" BorderThickness="0" Margin="28,0,28,16" AutomationProperties.Name="当前动作进度"/>
            <TextBlock x:Name="NextStep" Visibility="Collapsed" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
            <TextBlock x:Name="StepLabel" Visibility="Collapsed" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="ScenicPanel" Grid.Column="1" Margin="40,12,12,12" MaxWidth="580" MaxHeight="700" ui:Motion.Enter="True">
          <Border x:Name="SceneryFrame" CornerRadius="180,180,28,28" Background="Transparent"/>
          <ui:SceneImage x:Name="RestArt"  CornerRadius="28"/>
          <Border Background="#F7FBFAF5" CornerRadius="18" Padding="20,16" Margin="20" VerticalAlignment="Bottom">
            <StackPanel><TextBlock x:Name="SceneName" Text="此刻，无需赶路" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SceneNote" Text="远处的风景，值得抬头看看。" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,8,0,0"/>
              <StackPanel x:Name="RoutePanel" Margin="0,16,0,0">
                <Border Background="#D6DED1" Height="1" Margin="0,0,0,12"/>
                <TextBlock x:Name="RouteHeading" Text="这次的活动" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                <ItemsControl x:Name="RouteItems" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate>
                  <DockPanel Margin="0,5"><TextBlock Text="{Binding Duration}" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"/><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="{Binding Weight}"/></DockPanel>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </DockPanel>
  </Border>
</Window>
