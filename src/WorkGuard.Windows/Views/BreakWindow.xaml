<Window x:Class="WorkGuard.Windows.Views.BreakWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="工作防沉迷 · 休息" Width="640" Height="700" WindowStyle="None" ResizeMode="NoResize"
 ShowInTaskbar="False" Topmost="True" Background="#F1F4EC" KeyDown="Window_KeyDown">
 <Border BorderThickness="1" BorderBrush="#D7E0D3" Padding="28">
  <DockPanel>
   <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
    <Button DockPanel.Dock="Right" Content="退出 · Esc" Click="Exit_Click" Padding="12,8"/>
    <TextBlock Text="工作防沉迷 / 休息时间" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
   </DockPanel>
   <TextBlock x:Name="Footnote" DockPanel.Dock="Bottom" Text="以舒适为准。疼痛、麻木或头晕时，请停止。" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="650" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,16">
     <TextBlock x:Name="Eyebrow" Text="先放下手头的事" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
     <TextBlock x:Name="Glyph" Text="○" FontSize="72" TextAlignment="Center" Foreground="{StaticResource AccentBrush}" Margin="0,20,0,12"/>
     <TextBlock x:Name="Heading" Text="身体需要活动一下" FontSize="34" FontWeight="SemiBold" TextAlignment="Center"/>
     <TextBlock x:Name="Instruction" FontSize="18" TextAlignment="Center" LineHeight="30" Margin="0,18,0,16"/>
     <TextBlock x:Name="Countdown" FontSize="56" FontWeight="Light" TextAlignment="Center" Margin="0,0,0,12"/>
     <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="#DCE5D7" BorderThickness="0" Margin="0,8,0,20" AutomationProperties.Name="当前动作进度"/>
     <WrapPanel HorizontalAlignment="Center">
      <Button x:Name="StartButton" Content="开始休息" Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
      <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" Visibility="Collapsed"/>
      <Button x:Name="SkipButton" Content="跳过这个动作" Click="Skip_Click" Visibility="Collapsed"/>
      <Button x:Name="SnoozeButton" Content="5 分钟后提醒" Click="Exit_Click"/>
     </WrapPanel>
     <TextBlock x:Name="StepLabel" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
    </StackPanel>
   </ScrollViewer>
  </DockPanel>
 </Border>
</Window>
