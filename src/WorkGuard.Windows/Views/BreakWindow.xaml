<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WorkGuard.Windows.Views" x:Class="WorkGuard.Windows.Views.BreakWindow" Style="{StaticResource AppWindow}" Title="工作防沉迷 · 休息" Width="640" Height="700" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="#F1F4EC" KeyDown="Window_KeyDown">
  <Border BorderThickness="1" BorderBrush="#D7E0D3" Padding="24">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <Button x:Name="ExitButton" DockPanel.Dock="Right" Content="退出 · Esc" ui:Visuals.Glyph="&#xE711;" Click="Exit_Click" Padding="12,8"/>
        <TextBlock Text="工作防沉迷 / 休息时间" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
      </DockPanel>
      <Border x:Name="EmergencyPanel" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FFF1DD" CornerRadius="12" Padding="16" Margin="0,0,0,12" MaxWidth="800">
        <StackPanel>
          <TextBlock Text="需要立刻使用电脑？" FontWeight="SemiBold" FontSize="18"/>
          <TextBlock Text="退出后不会记为完成，5 分钟后再提醒。身体不适请立即停止活动。" Margin="0,6"/>
          <WrapPanel><Button x:Name="ConfirmExitButton" Content="确认紧急退出" Click="ConfirmExit_Click"/><Button x:Name="ContinueButton" Content="继续休息" Click="Continue_Click"/></WrapPanel>
        </StackPanel>
      </Border>
      <TextBlock x:Name="Footnote" DockPanel.Dock="Bottom" Text="以舒适为准。疼痛、麻木或头晕时，请停止。" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
          <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="StartButton" Content="开始休息" Style="{StaticResource PrimaryButton}" ui:Visuals.Glyph="&#xE768;" Click="Start_Click"/>
            <Button x:Name="PauseButton" Content="暂停" ui:Visuals.Glyph="&#xE769;" Click="Pause_Click" Visibility="Collapsed"/>
            <Button x:Name="SkipButton" Content="跳过这个动作" ui:Visuals.Glyph="&#xE893;" Click="Skip_Click" Visibility="Collapsed"/>
            <Button x:Name="AlternativeButton" Content="动作不适合 · 改为安静休息" Click="Alternative_Click" Visibility="Collapsed"/>
            <Button x:Name="SnoozeButton" Content="5 分钟后提醒" ui:Visuals.Glyph="&#xE823;" Click="Exit_Click"/>
          </WrapPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="SceneContent" MaxWidth="650" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,8">
          <TextBlock x:Name="Eyebrow" Text="先放下手头的事" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
          <Image x:Name="RestArt" Source="{StaticResource WorkdayArt}" Width="200" Height="136" Stretch="Uniform" Margin="0,8" IsHitTestVisible="False"/>
          <Border x:Name="StateBadge" Style="{StaticResource IconBadge}" Width="52" Height="52" CornerRadius="16" HorizontalAlignment="Center" Margin="0,18,0,4" Visibility="Collapsed"><ui:Symbol Text="&#xE916;" FontSize="26" Foreground="{StaticResource AccentBrush}"/></Border>
          <TextBlock x:Name="Heading" Text="身体需要活动一下" Margin="0,12,0,0" FontSize="30" FontWeight="SemiBold" TextAlignment="Center"/>
          <TextBlock x:Name="Instruction" FontSize="16" TextAlignment="Center" LineHeight="26" Margin="0,10,0,12"/>
          <TextBlock x:Name="Countdown" FontSize="44" FontWeight="Light" TextAlignment="Center" Margin="0,0,0,12"/>
          <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="#DCE5D7" BorderThickness="0" Margin="0,8,0,20" AutomationProperties.Name="当前动作进度"/>

          <TextBlock x:Name="NextStep" Visibility="Collapsed" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
          <TextBlock x:Name="StepLabel" Visibility="Collapsed" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
